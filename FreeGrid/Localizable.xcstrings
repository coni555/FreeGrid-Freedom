    "%": {},
    "%@\n\n这份备份有 %@，恢复会慢一些。确认是这份，就点「继续检查」，之后还会先给你看预览。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nThis backup is %2$@, so restoring will take a little longer. If it's the right one, tap “Keep Checking”. You'll still see a preview first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@\n\n这份备份有 %2$@，恢复会慢一些。确认是这份，就点「继续检查」，之后还会先给你看预览。"
          }
        }
      }
    },
