    "只有资产或只有现金，缺了另一半": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has assets or cash but not both"
          }
        }
      }
    },
    "只看「%@」 · %lld 笔": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only “%1$@” · %#@count@"
          },
          "substitutions": {
